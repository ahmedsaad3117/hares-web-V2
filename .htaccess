<IfModule mod_headers.c>
  # Entry documents must be revalidated so a deployment immediately exposes
  # its new versioned asset URLs without asking visitors to clear their cache.
  <FilesMatch "\.(?:html?)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Static application files may be cached locally, but browsers must validate
  # them with the server before reuse. Unchanged files normally return a 304.
  <FilesMatch "\.(?:css|js|json)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Images and fonts are stable and can retain a short cache lifetime.
  <FilesMatch "\.(?:png|jpe?g|gif|svg|webp|ico|woff2?|ttf|otf)$">
    Header always set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
